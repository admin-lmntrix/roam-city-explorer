# PostgreSQL connection string (Neon, Supabase, Railway, RDS, local...)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/city_explorer?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# Only needed if your host does not set the URL automatically
AUTH_URL="http://localhost:3000"

# Used by `npm run db:seed` to create the first admin account.
# If ADMIN_PASSWORD is empty, a random one is generated and printed once.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
